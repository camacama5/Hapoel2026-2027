rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // רשימת מזהי הקבוצות התקפים - חייבת להיות זהה בדיוק לזו שב-js/teams.js.
    // אם תשנה/תוסיף/תגרע קבוצה ב-teams.js, עדכן גם כאן.
    function validTeamIds() {
      return [
        "ironi_ashkelon", "ramat_hasharon", "maccabi_kiryat_gat",
        "maccabi_rehovot", "hapoel_haifa", "hapoel_migdal_haemek",
        "maccabi_petah_tikva", "elitzur_shomron", "elitzur_yavne",
        "otef_darom", "ironi_nahariya", "elitzur_netanya",
        "maccabi_raanana", "maccabi_kiryat_motzkin", "hapoel_hevel_modiin"
      ];
    }

    function closingDate() {
      return get(/databases/$(database)/documents/config/gameSettings).data.closingDate;
    }

    function revealDate() {
      return get(/databases/$(database)/documents/config/gameSettings).data.revealDate;
    }

    function gameIsOpen() {
      return request.time < closingDate();
    }

    function resultsRevealed() {
      return request.time > revealDate();
    }

    // ---------- config ----------
    // קריאה פתוחה לכולם - הקליינט צריך לדעת מהם מועדי הסגירה/החשיפה.
    // כתיבה חסומה לגמרי - עריכה אפשרית רק דרך קונסולת Firebase (שם, לא דרך האתר).
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- guesses ----------
    // מסמך "ציבורי" - רק שם המשתתף ותאריך השליחה. בכוונה בלי הקבוצות עצמן,
    // כדי שאפשר יהיה להראות "מי כבר ניחש" בלי לחשוף את תוכן הניחוש.
    match /guesses/{guessId} {
      allow read: if true;

      allow create: if
        gameIsOpen() &&
        request.resource.data.keys().hasOnly(["participantName", "submittedAt"]) &&
        request.resource.data.participantName is string &&
        request.resource.data.participantName.size() > 0 &&
        request.resource.data.participantName.size() <= 40 &&
        request.resource.data.submittedAt == request.time;

      allow update, delete: if false;
    }

    // ---------- guessTeams ----------
    // מסמך "פרטי" - 15 הקבוצות שנוחשו, עם אותו מזהה כמו ב-guesses.
    // קריאה חסומה עד מועד החשיפה (revealDate) - זה מה שמונע "העתקה" בזמן שהמשחק פתוח.
    // הערה: אין כאן בדיקת exists() מול guesses/{guessId}, כי שני המסמכים נכתבים
    // יחד באותו batch, ובדיקת exists() על מסמך שנכתב באותה פעולה לא אמינה.
    match /guessTeams/{guessId} {
      allow read: if resultsRevealed();

      allow create: if
        gameIsOpen() &&
        request.resource.data.keys().hasOnly(["teams"]) &&
        request.resource.data.teams is list &&
        request.resource.data.teams.size() == 15 &&
        request.resource.data.teams.hasOnly(validTeamIds()) &&
        request.resource.data.teams.toSet().size() == 15;

      allow update, delete: if false;
    }
  }
}
